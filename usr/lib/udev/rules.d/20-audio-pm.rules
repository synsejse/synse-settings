# Disable HDA power save on desktop / non-battery systems (prevents crackling)

ACTION=="add", SUBSYSTEM=="sound", KERNEL=="card*", DRIVERS=="snd_hda_intel", \
    RUN+="/usr/bin/sh -c 'echo 0 > /sys/module/snd_hda_intel/parameters/power_save'"

# Restore safe default on power state changes (best-effort only)
SUBSYSTEM=="power_supply", ENV{POWER_SUPPLY_ONLINE}=="1", \
    RUN+="/usr/bin/sh -c 'echo 10 > /sys/module/snd_hda_intel/parameters/power_save'"

SUBSYSTEM=="power_supply", ENV{POWER_SUPPLY_ONLINE}=="0", \
    RUN+="/usr/bin/sh -c 'echo 10 > /sys/module/snd_hda_intel/parameters/power_save'"
